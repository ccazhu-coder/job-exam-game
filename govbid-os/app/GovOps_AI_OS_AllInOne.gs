/**
 * GovOps AI OS｜All-In-One GAS Backend
 * Runtime：Tenant Isolation + SaaS Login Session + AI Command Center Runtime
 */
const GOVOPS={TZ:'Asia/Taipei',SESSION_HOURS:12,SHEETS:{Tenants:'01_Tenants',Users:'02_Users',Roles:'03_Roles',Sessions:'04_Sessions',LoginLogs:'05_LoginLogs',Projects:'02_專案主檔',Activities:'03_活動課程主檔',Finance:'20_財務收支資料',Tasks:'21_任務管理',Checks:'22_檢核清單',Docs:'23_文件索引與版本',Risks:'25_AI風險警示',Daily:'26_每日戰情紀錄',Audit:'90_操作紀錄'},ROLE_PERMISSIONS:{老闆:['*'],系統管理員:['*'],專案經理:['*'],行政人員:['查詢專案','查詢活動','新增活動','查詢任務','新增文件','查詢文件','取得Dashboard','getAiCommandCenter','getTodayPriorities','getProjectHealthScores','getOperationHeatmap','getHighRiskItems','getWorkloadPressure','getCrossProjectConflicts','LINE查詢'],會計人員:['查詢專案','查詢活動','新增財務','查詢財務','檢查專案核銷缺件','判斷專案是否可請款','查詢文件','新增文件','取得Dashboard','getAiCommandCenter','getTodayPriorities','getProjectHealthScores','getOperationHeatmap','getHighRiskItems','getWorkloadPressure','LINE查詢'],只讀人員:['查詢專案','查詢活動','查詢任務','查詢財務','查詢文件','取得Dashboard','getAiCommandCenter','getTodayPriorities','getProjectHealthScores','getOperationHeatmap','getHighRiskItems','getWorkloadPressure','getCrossProjectConflicts','LINE查詢']}};
function doGet(e){return jsonOut({success:true,成功:true,message:'GovOps AI OS API 已啟動',runtime:'AI Command Center Runtime',time:nowText()});}
function doPost(e){try{const body=JSON.parse(e.postData&&e.postData.contents?e.postData.contents:'{}');const action=body.action||'';const data=body.data||{};const filters=body.filters||{};let result;if(['login','logout','getSession','refreshSession','getCurrentUser','初始化系統','建立登入測試帳號','健康檢查'].indexOf(action)>=0){result=publicRoute(action,data,body);}else{const ctx=getSessionContext(body);tenantGuard(action,data,filters,ctx);roleGuard(action,ctx);result=routeAction(action,data,filters,ctx);touchSession(ctx.token);}return jsonOut(Object.assign({success:true,成功:true,action},result&&result.token?result:{result:result,結果:result}));}catch(err){return jsonOut({success:false,成功:false,error:err.message,錯誤訊息:err.message,type:'AI_COMMAND_RUNTIME_ERROR',time:nowText()});}}
function publicRoute(action,data,body){switch(action){case'健康檢查':return{message:'API 正常',runtime:'AI Command Center Runtime',time:nowText()};case'初始化系統':return 初始化系統();case'建立登入測試帳號':return 建立登入測試帳號(data);case'login':return login(data);case'logout':return logout(getToken(body));case'getSession':return getSessionInfo(getToken(body));case'refreshSession':return refreshSession(getToken(body));case'getCurrentUser':return getCurrentUser(getToken(body));default:throw new Error('未知公開 action：'+action);}}
function routeAction(action,data,filters,ctx){switch(action){case'getAiCommandCenter':return getAiCommandCenter(ctx);case'getTodayPriorities':return getTodayPriorities(ctx);case'getProjectHealthScores':return getProjectHealthScores(ctx);case'getOperationHeatmap':return getOperationHeatmap(ctx);case'getHighRiskItems':return getHighRiskItems(ctx);case'getWorkloadPressure':return getWorkloadPressure(ctx);case'getCrossProjectConflicts':return getCrossProjectConflicts(ctx);case'refreshAiRiskRuntime':return refreshAiRiskRuntime(ctx);case'取得Dashboard':return getAiCommandCenter(ctx);case'產生今日戰情':return 產生今日戰情(ctx);case'每日AI風險檢查':return refreshAiRiskRuntime(ctx);case'新增專案':return 新增專案(data,ctx);case'查詢專案':return querySheet(GOVOPS.SHEETS.Projects,filters,ctx);case'新增活動':return 新增活動(data,ctx);case'查詢活動':return querySheet(GOVOPS.SHEETS.Activities,filters,ctx);case'查詢任務':return querySheet(GOVOPS.SHEETS.Tasks,filters,ctx);case'新增財務':return 新增財務(data,ctx);case'查詢財務':return querySheet(GOVOPS.SHEETS.Finance,filters,ctx);case'新增文件':return 新增文件(data,ctx);case'查詢文件':return querySheet(GOVOPS.SHEETS.Docs,filters,ctx);case'檢查專案核銷缺件':return 檢查專案核銷缺件(data.專案ID,ctx);case'判斷專案是否可請款':return 判斷專案是否可請款(data.專案ID,ctx);case'LINE查詢':return LINE查詢(data.文字||'',ctx);default:throw new Error('尚未支援 action：'+action);}}
function getSchemas(){const meta=['tenantId','companyCode','userId','role','createdAt','updatedAt','status'];const o={};o[GOVOPS.SHEETS.Tenants]=['tenantId','companyCode','companyName','plan','status','ownerUserId','createdAt','updatedAt'];o[GOVOPS.SHEETS.Users]=['userId','tenantId','companyCode','email','passwordHash','displayName','role','status','lastLoginAt','createdAt','updatedAt'];o[GOVOPS.SHEETS.Roles]=['roleId','tenantId','role','permissionJson','status','createdAt','updatedAt'];o[GOVOPS.SHEETS.Sessions]=['sessionId','token','tenantId','companyCode','userId','role','expiresAt','status','createdAt','lastSeenAt'];o[GOVOPS.SHEETS.LoginLogs]=['logId','tenantId','companyCode','userId','email','action','result','message','createdAt'];o[GOVOPS.SHEETS.Projects]=['專案ID','專案名稱','專案類型','機關名稱','契約編號','契約金額','履約起日','履約迄日','請款方式','專案負責人ID','專案狀態','健康分數','風險等級'].concat(meta);o[GOVOPS.SHEETS.Activities]=['活動ID','專案ID','活動名稱','活動類型','活動日期','開始時間','結束時間','活動地點','講師ID','工作人員ID','場地ID','設備ID','預計人數','活動狀態','GoogleCalendar事件ID','LINE通知狀態'].concat(meta);o[GOVOPS.SHEETS.Finance]=['財務ID','專案ID','活動ID','類型','金額','付款狀態','交易日期','請款日期','撥款日期','核銷狀態','說明'].concat(meta);o[GOVOPS.SHEETS.Tasks]=['任務ID','專案ID','活動ID','負責人ID','任務類型','任務階段','任務名稱','預計完成日','實際完成日','任務狀態','是否啟用','逾期提醒'].concat(meta);o[GOVOPS.SHEETS.Checks]=['檢核ID','專案ID','活動ID','檢核階段','檢核項目','是否完成','缺件說明'].concat(meta);o[GOVOPS.SHEETS.Docs]=['文件ID','專案ID','活動ID','文件類型','文件名稱','版本','檔案連結','檔案ID','是否最新版','文件狀態'].concat(meta);o[GOVOPS.SHEETS.Risks]=['風險ID','專案ID','活動ID','風險類型','風險等級','風險標題','風險說明','處理狀態'].concat(meta);o[GOVOPS.SHEETS.Daily]=['戰情ID','日期','LINE文字'].concat(meta);o[GOVOPS.SHEETS.Audit]=['紀錄ID','動作','資料表','資料ID','操作人','內容'].concat(meta);return o;}
function 初始化系統(){const schemas=getSchemas();Object.keys(schemas).forEach(n=>ensureSheet(n,schemas[n]));return{message:'初始化完成，已建立 AI Command Center Runtime 所需資料表',資料表數:Object.keys(schemas).length};}
function 建立登入測試帳號(data){初始化系統();const tenantId=data.tenantId||'tenant_demo';const companyCode=data.companyCode||'demo';const email=data.email||'admin@example.com';const password=data.password||'123456';const userId='USR_'+companyCode+'_ADMIN';if(!findOne(GOVOPS.SHEETS.Tenants,{tenantId:tenantId}))appendRaw(GOVOPS.SHEETS.Tenants,{tenantId,companyCode,companyName:data.companyName||'Demo公司',plan:data.plan||'PRO',status:'啟用',ownerUserId:userId,createdAt:nowText(),updatedAt:nowText()});if(!findOne(GOVOPS.SHEETS.Users,{tenantId:tenantId,email:email}))appendRaw(GOVOPS.SHEETS.Users,{userId,tenantId,companyCode,email,passwordHash:hashPassword(password),displayName:data.displayName||'系統管理者',role:data.role||'老闆',status:'啟用',createdAt:nowText(),updatedAt:nowText()});return{message:'登入測試帳號已建立',companyCode,email,password};}
function getAiData(ctx){return{projects:getRows(GOVOPS.SHEETS.Projects,{},ctx),activities:getRows(GOVOPS.SHEETS.Activities,{},ctx),tasks:getRows(GOVOPS.SHEETS.Tasks,{},ctx),finance:getRows(GOVOPS.SHEETS.Finance,{},ctx),checks:getRows(GOVOPS.SHEETS.Checks,{},ctx),docs:getRows(GOVOPS.SHEETS.Docs,{},ctx),risks:getRows(GOVOPS.SHEETS.Risks,{},ctx)};}
function getAiCommandCenter(ctx){const data=getAiData(ctx);const todayPriorities=getTodayPriorities(ctx,data);const projectHealthScores=getProjectHealthScores(ctx,data);const operationHeatmap=getOperationHeatmap(ctx,data);const highRiskItems=getHighRiskItems(ctx,data,projectHealthScores,todayPriorities);const workloadPressure=getWorkloadPressure(ctx,data);const crossProjectConflicts=getCrossProjectConflicts(ctx,data);const aiSuggestions=generateAiSuggestions(data,todayPriorities,highRiskItems,workloadPressure,crossProjectConflicts);const summary={專案數:data.projects.length,活動數:data.activities.length,今日活動數:data.activities.filter(a=>dateOnly(a.活動日期)===today()).length,逾期任務數:data.tasks.filter(t=>isOverdue(t.預計完成日)&&t.任務狀態!=='已完成').length,高風險案件數:highRiskItems.length,核銷缺件數:data.checks.filter(c=>!truthy(c.是否完成)).length,未完成請款數:data.finance.filter(f=>['未請款','未撥款','應收款'].indexOf(String(f.類型))>=0||['未撥款','待請款'].indexOf(String(f.付款狀態))>=0).length,本週活動數:data.activities.filter(a=>betweenDays(a.活動日期,0,7)).length,結案倒數案件:projectHealthScores.filter(p=>p.riskReasons.join(' ').indexOf('結案倒數')>=0).length};return{summary,摘要:summary,todayPriorities,projectHealthScores,operationHeatmap,highRiskItems,workloadPressure,crossProjectConflicts,aiSuggestions,AI建議:aiSuggestions,今日活動:data.activities.filter(a=>dateOnly(a.活動日期)===today()),逾期任務:data.tasks.filter(t=>isOverdue(t.預計完成日)&&t.任務狀態!=='已完成'),高風險案件:highRiskItems,runtimeStatus:{tenantAware:true,sessionAware:true,aiRuntime:'正常',updatedAt:nowText()},目前登入:{tenantId:ctx.tenantId,companyCode:ctx.companyCode,userId:ctx.userId,role:ctx.role}};}
function getTodayPriorities(ctx,data){data=data||getAiData(ctx);const ps=[];const pmap=mapBy(data.projects,'專案ID');const amap=mapBy(data.activities,'活動ID');data.tasks.forEach(t=>{if(t.任務狀態==='已完成')return;let score=scoreDue(t.預計完成日);if(String(t.任務類型).indexOf('核銷')>=0)score+=25;if(String(t.任務名稱).indexOf('文件')>=0||String(t.任務名稱).indexOf('簽到')>=0)score+=10;const p=pmap[t.專案ID]||{},a=amap[t.活動ID]||{};ps.push(priorityRow(score,t.專案ID,p.專案名稱,t.活動ID,a.活動名稱,'任務',t.任務名稱||'待辦任務','任務尚未完成，可能影響履約進度。','立即處理任務',t.預計完成日,'openTask'));});data.checks.forEach(c=>{if(truthy(c.是否完成))return;const p=pmap[c.專案ID]||{},a=amap[c.活動ID]||{};ps.push(priorityRow(25+scoreDue(a.活動日期),c.專案ID,p.專案名稱,c.活動ID,a.活動名稱,'核銷缺件','缺件：'+(c.檢核項目||''),'核銷或結案資料尚未補齊。','補齊缺件',a.活動日期,'fixMissing'));});data.finance.forEach(f=>{let score=0;if(['未請款','應收款'].indexOf(String(f.類型))>=0)score+=20;if(['未撥款','待請款'].indexOf(String(f.付款狀態))>=0)score+=20;if(Number(f.金額||0)>50000)score+=15;if(daysBetween(f.請款日期||f.交易日期,today())>30)score+=10;const p=pmap[f.專案ID]||{},a=amap[f.活動ID]||{};if(score>0)ps.push(priorityRow(score,f.專案ID,p.專案名稱,f.活動ID,a.活動名稱,'請款財務',f.說明||'請款／撥款待追蹤','此筆財務可能影響現金流。','追蹤請款或撥款',f.交易日期,'openFinance'));});data.activities.forEach(a=>{let score=0;if(betweenDays(a.活動日期,0,3))score+=20;if(!a.GoogleCalendar事件ID)score+=8;if(!a.LINE通知狀態)score+=8;const p=pmap[a.專案ID]||{};if(score>0)ps.push(priorityRow(score,a.專案ID,p.專案名稱,a.活動ID,a.活動名稱,'活動準備','活動準備待確認','活動日期接近，需確認通知、場地、簽到與物資。','檢查活動準備',a.活動日期,'openActivity'));});return ps.filter(x=>x.priorityScore>0).sort((a,b)=>b.priorityScore-a.priorityScore).slice(0,5);}
function priorityRow(score,pid,pn,aid,an,type,title,desc,act,due,quick){return{priorityId:makeId('PRI'),priorityScore:score,riskLevel:score>=70?'高風險':score>=40?'注意':'正常',projectId:pid||'',projectName:pn||'',activityId:aid||'',activityName:an||'',type,title,description:desc,suggestedAction:act,dueDate:due||'',quickAction:quick};}
function getProjectHealthScores(ctx,data){data=data||getAiData(ctx);const conflicts=getCrossProjectConflicts(ctx,data);return data.projects.map(p=>{let score=100,reasons=[],actions=[];const pid=p.專案ID;const ts=data.tasks.filter(t=>t.專案ID===pid);const cs=data.checks.filter(c=>c.專案ID===pid);const fs=data.finance.filter(f=>f.專案ID===pid);const ds=data.docs.filter(d=>d.專案ID===pid);const acts=data.activities.filter(a=>a.專案ID===pid);const overdue=ts.filter(t=>isOverdue(t.預計完成日)&&t.任務狀態!=='已完成').length;if(overdue){score-=overdue*8;reasons.push('逾期任務 '+overdue+' 筆');actions.push('優先清理逾期任務');}const miss=cs.filter(c=>!truthy(c.是否完成)).length;if(miss){score-=miss*6;reasons.push('核銷缺件 '+miss+' 項');actions.push('補齊核銷與結案缺件');}const docMiss=ds.filter(d=>!d.檔案連結||d.是否最新版===false).length;if(docMiss){score-=docMiss*5;reasons.push('文件缺件或版本異常 '+docMiss+' 筆');actions.push('更新文件索引與版本');}fs.forEach(f=>{if(daysBetween(f.請款日期||f.交易日期,today())>30&&String(f.付款狀態)!=='已撥款'){score-=10;reasons.push('請款超過30天未撥款');actions.push('追蹤機關撥款進度');}});acts.forEach(a=>{if(betweenDays(a.活動日期,0,7)){const pending=ts.filter(t=>t.活動ID===a.活動ID&&t.任務狀態!=='已完成').length;if(pending){score-=12;reasons.push('活動前7天準備未完成');actions.push('檢查活動前任務');}if(!a.GoogleCalendar事件ID){score-=3;reasons.push('Google Calendar 未同步');}if(!a.LINE通知狀態){score-=3;reasons.push('LINE 通知未完成');}}});const conflictCount=conflicts.filter(c=>String(c.relatedProjects).indexOf(pid)>=0).length;if(conflictCount){score-=conflictCount*8;reasons.push('跨案衝突 '+conflictCount+' 件');actions.push('調整人力、講師或場地');}score=Math.max(0,score);return{projectId:pid,projectName:p.專案名稱,healthScore:score,healthLevel:healthLevel(score),riskReasons:reasons,suggestedActions:unique(actions),updatedAt:nowText()};}).sort((a,b)=>a.healthScore-b.healthScore);}
function getOperationHeatmap(ctx,data){data=data||getAiData(ctx);const conflicts=getCrossProjectConflicts(ctx,data);const out=[];for(let i=0;i<30;i++){const d=addDays(today(),i);const activityCount=data.activities.filter(a=>dateOnly(a.活動日期)===d).length;const taskDueCount=data.tasks.filter(t=>dateOnly(t.預計完成日)===d).length;const claimDueCount=data.finance.filter(f=>dateOnly(f.請款日期||f.交易日期)===d&&String(f.類型).indexOf('請款')>=0).length;const reimbursementDueCount=data.checks.filter(c=>dateOnly(c.updatedAt||c.createdAt)===d&&!truthy(c.是否完成)).length;const closingDueCount=data.projects.filter(p=>dateOnly(p.履約迄日)===d).length;const conflictCount=conflicts.filter(c=>c.date===d).length;const highRiskActivityCount=data.activities.filter(a=>dateOnly(a.活動日期)===d&&betweenDays(a.活動日期,0,3)).length;const fileMissing=data.docs.filter(doc=>dateOnly(doc.updatedAt||doc.createdAt)===d&&!doc.檔案連結).length;const score=activityCount*10+taskDueCount*6+reimbursementDueCount*12+claimDueCount*10+closingDueCount*15+highRiskActivityCount*12+conflictCount*10+fileMissing*4;out.push({date:d,pressureScore:score,pressureLevel:pressureLevel(score),activityCount,taskDueCount,claimDueCount,reimbursementDueCount,closingDueCount,conflictCount,riskSummary:score>=70?'爆量日，請提前分流工作':score>=40?'高壓日，請提前處理文件與通知':score>=20?'中壓日，注意任務到期':'低壓日'});}return out;}
function getHighRiskItems(ctx,data,health,priorities){data=data||getAiData(ctx);health=health||getProjectHealthScores(ctx,data);priorities=priorities||getTodayPriorities(ctx,data);const items=[];health.filter(h=>h.healthScore<70).forEach(h=>items.push({riskId:makeId('HR'),riskType:'專案健康度',riskLevel:h.healthLevel,projectId:h.projectId,projectName:h.projectName,title:'專案健康度低於70',description:h.riskReasons.join('、'),suggestedAction:(h.suggestedActions[0]||'請檢查專案風險')}));priorities.filter(p=>p.priorityScore>=40).forEach(p=>items.push({riskId:makeId('HR'),riskType:p.type,riskLevel:p.riskLevel,projectId:p.projectId,projectName:p.projectName,activityId:p.activityId,activityName:p.activityName,title:p.title,description:p.description,suggestedAction:p.suggestedAction}));return items.slice(0,20);}
function getCrossProjectConflicts(ctx,data){data=data||getAiData(ctx);const conflicts=[];const groups={};data.activities.forEach(a=>{const key=dateOnly(a.活動日期)+'|'+(a.開始時間||'')+'|'+(a.結束時間||'');['講師ID','工作人員ID','場地ID','設備ID'].forEach(field=>{if(a[field]){const k=field+'|'+a[field]+'|'+key;if(!groups[k])groups[k]=[];groups[k].push(a);}});});Object.keys(groups).forEach(k=>{const arr=groups[k];if(arr.length>1){conflicts.push({conflictId:makeId('CON'),conflictType:k.split('|')[0]+'衝突',date:dateOnly(arr[0].活動日期),timeRange:(arr[0].開始時間||'')+'-'+(arr[0].結束時間||''),relatedProjects:arr.map(a=>a.專案ID).join(','),relatedActivities:arr.map(a=>a.活動ID).join(','),description:'同一資源同一時間出現在多場活動',severity:'高風險',suggestedAction:'請調整活動時間或重新分配資源'});}});const byDay={};data.activities.forEach(a=>{const d=dateOnly(a.活動日期);byDay[d]=(byDay[d]||0)+1;});Object.keys(byDay).forEach(d=>{if(byDay[d]>=4)conflicts.push({conflictId:makeId('CON'),conflictType:'同一天活動過多',date:d,timeRange:'全天',relatedProjects:'',relatedActivities:'',description:'同一天活動數達 '+byDay[d]+' 場',severity:'注意',suggestedAction:'請提前確認人力、物資、交通與通知'});});return conflicts;}
function getWorkloadPressure(ctx,data){data=data||getAiData(ctx);const users={};function add(uid,k){uid=uid||ctx.userId;if(!users[uid])users[uid]={userId:uid,displayName:uid,taskCount:0,overdueCount:0,activityCount:0,financeCount:0,closingCount:0};users[uid][k]++;}data.tasks.filter(t=>betweenDays(t.預計完成日,0,7)).forEach(t=>{add(t.負責人ID,'taskCount');if(isOverdue(t.預計完成日)&&t.任務狀態!=='已完成')add(t.負責人ID,'overdueCount');});data.activities.filter(a=>betweenDays(a.活動日期,0,7)).forEach(a=>add(ctx.userId,'activityCount'));data.finance.filter(f=>betweenDays(f.交易日期,0,7)).forEach(f=>add(ctx.userId,'financeCount'));return Object.values(users).map(u=>{const total=u.taskCount+u.overdueCount+u.activityCount+u.financeCount+u.closingCount;u.workloadLevel=total>=19?'超載':total>=11?'高壓':total>=6?'偏高':'正常';u.suggestedAction=u.workloadLevel==='正常'?'維持追蹤即可':'建議延後非急件，優先處理核銷、請款與逾期任務';return u;});}
function refreshAiRiskRuntime(ctx){const command=getAiCommandCenter(ctx);command.highRiskItems.forEach(r=>appendRow(GOVOPS.SHEETS.Risks,{風險ID:makeId('RSK'),專案ID:r.projectId,活動ID:r.activityId||'',風險類型:r.riskType,風險等級:r.riskLevel,風險標題:r.title,風險說明:r.description,處理狀態:'待處理'},ctx));return{message:'AI Risk Runtime 已重新計算',新增風險數:command.highRiskItems.length,commandCenter:command};}
function generateAiSuggestions(data,priorities,highRisk,workload,conflicts){if(!data.projects.length)return['目前尚未建立專案資料，請先新增專案或同步資料。'];const tips=[];if(highRisk.length)highRisk.slice(0,3).forEach(r=>tips.push('請優先處理「'+(r.projectName||r.title)+'」：'+(r.suggestedAction||'立即確認風險來源')));if(conflicts.length)tips.push('AI 發現 '+conflicts.length+' 件跨案衝突，請先檢查同日活動、人力與場地安排。');const overload=workload.filter(w=>['高壓','超載'].indexOf(w.workloadLevel)>=0);if(overload.length)tips.push('本週有 '+overload.length+' 位人員工作負載偏高，建議重新分配任務。');if(!tips.length)tips.push('目前營運狀態穩定，建議持續追蹤本週活動與請款進度。');return tips;}
function scoreDue(d){if(!d)return 0;const n=daysBetween(today(),d);if(n<0)return 40;if(n<=1)return 35;if(n<=3)return 25;if(n<=7)return 15;return 0;}function healthLevel(s){return s>=90?'安全':s>=70?'注意':s>=50?'高風險':'即將失控'}function pressureLevel(s){return s>=70?'爆量':s>=40?'高壓':s>=20?'中壓':'低壓'}function truthy(v){return v===true||String(v).toLowerCase()==='true'||String(v)==='已完成'}function isOverdue(d){return d&&daysBetween(d,today())>0}function betweenDays(d,a,b){if(!d)return false;const n=daysBetween(today(),d);return n>=a&&n<=b}function dateOnly(d){return d?Utilities.formatDate(new Date(d),GOVOPS.TZ,'yyyy-MM-dd'):''}function daysBetween(a,b){if(!a||!b)return 999;const x=new Date(dateOnly(a)),y=new Date(dateOnly(b));return Math.ceil((y-x)/86400000)}function mapBy(arr,k){const m={};arr.forEach(x=>m[x[k]]=x);return m}function unique(a){return Array.from(new Set(a.filter(Boolean)))}
function login(data){const email=String(data.email||'').trim().toLowerCase();const password=String(data.password||'');const companyCode=String(data.companyCode||'').trim();if(!email||!password||!companyCode)throw new Error('請輸入 companyCode、email、password');const tenant=findOne(GOVOPS.SHEETS.Tenants,{companyCode:companyCode});if(!tenant)throw new Error('租戶不存在');if(tenant.status!=='啟用')throw new Error('租戶未啟用');const user=findOne(GOVOPS.SHEETS.Users,{tenantId:tenant.tenantId,email:email});if(!user)throw new Error('使用者不存在');if(user.status!=='啟用')throw new Error('使用者未啟用');if(user.passwordHash!==hashPassword(password))throw new Error('帳號或密碼錯誤');const token=makeToken();const expiresAt=addHours(nowDate(),GOVOPS.SESSION_HOURS);appendRaw(GOVOPS.SHEETS.Sessions,{sessionId:makeId('SES'),token,tenantId:tenant.tenantId,companyCode,userId:user.userId,role:user.role,expiresAt:formatDate(expiresAt),status:'啟用',createdAt:nowText(),lastSeenAt:nowText()});return{success:true,token,tenantId:tenant.tenantId,companyCode,userId:user.userId,role:user.role,displayName:user.displayName,plan:tenant.plan,expiresAt:formatDate(expiresAt)};}
function logout(token){if(token)updateByKey(GOVOPS.SHEETS.Sessions,'token',token,{status:'已登出',lastSeenAt:nowText()});return{message:'已登出'};}function getSessionInfo(token){const s=getSessionRow(token,true);return{session:{tenantId:s.tenantId,companyCode:s.companyCode,userId:s.userId,role:s.role,expiresAt:s.expiresAt,status:s.status}};}function refreshSession(token){getSessionRow(token,true);const expiresAt=formatDate(addHours(nowDate(),GOVOPS.SESSION_HOURS));updateByKey(GOVOPS.SHEETS.Sessions,'token',token,{expiresAt,lastSeenAt:nowText()});return{message:'session 已延長',expiresAt};}function getCurrentUser(token){const s=getSessionRow(token,true);const u=findOne(GOVOPS.SHEETS.Users,{tenantId:s.tenantId,userId:s.userId});const t=findOne(GOVOPS.SHEETS.Tenants,{tenantId:s.tenantId});return{tenantId:s.tenantId,companyCode:s.companyCode,userId:s.userId,role:s.role,displayName:u?u.displayName:'',email:u?u.email:'',companyName:t?t.companyName:'',plan:t?t.plan:''};}function getSessionContext(body){const token=getToken(body);const s=getSessionRow(token,true);return{token,tenantId:s.tenantId,companyCode:s.companyCode,userId:s.userId,role:s.role};}function getToken(body){return String(body.token||body.Authorization||body.authorization||'').replace(/^Bearer\s+/i,'').trim();}function getSessionRow(token,strict){if(!token){if(strict)throw new Error('尚未登入或缺少 session token');return null;}const s=findOne(GOVOPS.SHEETS.Sessions,{token:token});if(!s){if(strict)throw new Error('session 不存在，請重新登入');return null;}if(s.status!=='啟用'){if(strict)throw new Error('session 已失效，請重新登入');return null;}if(new Date(s.expiresAt).getTime()<Date.now()){updateByKey(GOVOPS.SHEETS.Sessions,'token',token,{status:'已過期'});if(strict)throw new Error('session 已過期，請重新登入');return null;}return s;}function touchSession(token){if(token)updateByKey(GOVOPS.SHEETS.Sessions,'token',token,{lastSeenAt:nowText()});}function tenantGuard(action,data,filters,ctx){if(!ctx.tenantId||!ctx.companyCode||!ctx.userId||!ctx.role)throw new Error('session context 不完整');if(data.tenantId||data.companyCode||data.userId||data.role)throw new Error('拒絕存取：正式版 API 不允許前端手動指定 tenantId/companyCode/userId/role');}function roleGuard(action,ctx){const allowed=GOVOPS.ROLE_PERMISSIONS[ctx.role]||[];if(allowed.indexOf('*')>=0)return;if(allowed.indexOf(action)<0)throw new Error('權限不足：角色「'+ctx.role+'」不可執行「'+action+'」。');}
function appendRow(sheetName,data,ctx){appendRaw(sheetName,Object.assign({},data,{tenantId:ctx.tenantId,companyCode:ctx.companyCode,userId:ctx.userId,role:ctx.role,createdAt:data.createdAt||nowText(),updatedAt:nowText(),status:data.status||'啟用'}));return data;}function querySheet(sheetName,filters,ctx){return{資料:getRows(sheetName,filters||{},ctx)}}function getRows(sheetName,filters,ctx){return readRows(sheetName).filter(o=>String(o.tenantId||'')===String(ctx.tenantId)).filter(o=>String(o.companyCode||'')===String(ctx.companyCode)).filter(o=>String(o.status||'啟用')!=='已封存').filter(o=>Object.keys(filters||{}).every(k=>!filters[k]||String(o[k])===String(filters[k])));}function 新增專案(data,ctx){const id=makeId('PRJ');appendRow(GOVOPS.SHEETS.Projects,Object.assign({},data,{專案ID:id,健康分數:100,風險等級:'正常',專案狀態:data.專案狀態||'履約準備中'}),ctx);createProjectTasks(id,ctx);return{message:'專案已新增',專案ID:id};}function 新增活動(data,ctx){if(!data.專案ID)throw new Error('新增活動必須選擇專案');mustOwn(GOVOPS.SHEETS.Projects,'專案ID',data.專案ID,ctx);const id=makeId('ACT');appendRow(GOVOPS.SHEETS.Activities,Object.assign({},data,{活動ID:id,活動狀態:data.活動狀態||'籌備中'}),ctx);createActivityTasks(data.專案ID,id,ctx);createChecks(data.專案ID,id,ctx);return{message:'活動已新增',活動ID:id};}function 新增財務(data,ctx){const id=makeId('FIN');appendRow(GOVOPS.SHEETS.Finance,Object.assign({},data,{財務ID:id}),ctx);return{message:'財務已新增',財務ID:id};}function 新增文件(data,ctx){const id=makeId('DOC');appendRow(GOVOPS.SHEETS.Docs,Object.assign({},data,{文件ID:id}),ctx);return{message:'文件已新增',文件ID:id};}function createProjectTasks(projectId,ctx){['契約資料建檔','履約規格確認','請款規則確認','結案資料清單確認'].forEach((n,i)=>appendRow(GOVOPS.SHEETS.Tasks,{任務ID:makeId('TSK'),專案ID:projectId,任務類型:'專案任務',任務階段:'履約準備',任務名稱:n,預計完成日:addDays(today(),i+3),任務狀態:'未開始',是否啟用:true,逾期提醒:true},ctx));}function createActivityTasks(projectId,activityId,ctx){['確認場地與時間','確認講師與工作人員','準備簽到表','確認餐點與物資','整理核銷資料'].forEach((n,i)=>appendRow(GOVOPS.SHEETS.Tasks,{任務ID:makeId('TSK'),專案ID:projectId,活動ID:activityId,任務類型:'活動任務',任務階段:i<4?'活動前':'活動後',任務名稱:n,預計完成日:addDays(today(),i+1),任務狀態:'未開始',是否啟用:true,逾期提醒:true},ctx));}function createChecks(projectId,activityId,ctx){['簽到表','滿意度問卷','成果照片','講師領據','餐費發票','活動成果摘要'].forEach(n=>appendRow(GOVOPS.SHEETS.Checks,{檢核ID:makeId('CHK'),專案ID:projectId,活動ID:activityId,檢核階段:'核銷結案',檢核項目:n,是否完成:false},ctx));}
function 取得Dashboard(ctx){return getAiCommandCenter(ctx)}function 每日AI風險檢查(ctx){return refreshAiRiskRuntime(ctx)}function 產生今日戰情(ctx){const d=getAiCommandCenter(ctx);const text=['【今日 GovOps 戰情】','公司：'+ctx.companyCode,'高風險：'+d.summary.高風險案件數,'逾期任務：'+d.summary.逾期任務數,'核銷缺件：'+d.summary.核銷缺件數,'','AI建議：'].concat(d.aiSuggestions.map((x,i)=>(i+1)+'. '+x)).join('\n');appendRow(GOVOPS.SHEETS.Daily,{戰情ID:makeId('DAY'),日期:today(),LINE文字:text},ctx);return{LINE文字:text,Dashboard:d};}function 檢查專案核銷缺件(projectId,ctx){mustOwn(GOVOPS.SHEETS.Projects,'專案ID',projectId,ctx);const missing=getRows(GOVOPS.SHEETS.Checks,{專案ID:projectId},ctx).filter(x=>!truthy(x.是否完成)).map(x=>x.檢核項目);return{專案ID:projectId,缺件數:missing.length,缺件:missing,是否完整:missing.length===0};}function 判斷專案是否可請款(projectId,ctx){const m=檢查專案核銷缺件(projectId,ctx);return{可請款:m.缺件數===0,判斷:m.缺件數?'不可請款，仍有缺件':'可請款',缺件:m.缺件};}function LINE查詢(text,ctx){if(String(text).indexOf('戰情')>=0||String(text).indexOf('今日')>=0)return 產生今日戰情(ctx).LINE文字;return'可查詢：今日戰情、未請款、核銷缺件。';}
function mustOwn(sheet,key,value,ctx){const r=getRows(sheet,{[key]:value},ctx)[0];if(!r)throw new Error('找不到資料，或資料不屬於目前登入公司。');return r;}function readRows(sheetName){const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sheetName);if(!sh||sh.getLastRow()<2)return[];const values=sh.getDataRange().getValues();const h=values.shift();return values.map(r=>{const o={};h.forEach((k,i)=>o[k]=r[i]);return o;});}function findOne(sheetName,filters){return readRows(sheetName).find(o=>Object.keys(filters).every(k=>String(o[k])===String(filters[k])));}function appendRaw(sheetName,data){const sh=ensureSheet(sheetName,getSchemas()[sheetName]);const h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0];sh.appendRow(h.map(k=>data[k]!==undefined?data[k]:''));}function updateByKey(sheetName,key,value,patch){const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sheetName);if(!sh)return;const values=sh.getDataRange().getValues();const h=values[0];const idx=h.indexOf(key);for(let i=1;i<values.length;i++){if(String(values[i][idx])===String(value)){Object.keys(patch).forEach(k=>{const c=h.indexOf(k);if(c>=0)sh.getRange(i+1,c+1).setValue(patch[k]);});return;}}}function hashPassword(p){return Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(p)));}function makeToken(){return Utilities.getUuid().replace(/-/g,'')+'.'+Utilities.getUuid().replace(/-/g,'');}function ensureSheet(name,headers){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);const current=sh.getRange(1,1,1,Math.max(headers.length,sh.getLastColumn()||1)).getValues()[0].filter(String);if(!current.length)sh.getRange(1,1,1,headers.length).setValues([headers]);else{const miss=headers.filter(x=>current.indexOf(x)<0);if(miss.length)sh.getRange(1,current.length+1,1,miss.length).setValues([miss]);}sh.setFrozenRows(1);return sh;}function makeId(p){return p+Utilities.formatDate(new Date(),GOVOPS.TZ,'yyyyMMddHHmmss')+Math.floor(Math.random()*900+100);}function today(){return Utilities.formatDate(new Date(),GOVOPS.TZ,'yyyy-MM-dd');}function nowText(){return Utilities.formatDate(new Date(),GOVOPS.TZ,'yyyy-MM-dd HH:mm:ss');}function nowDate(){return new Date();}function addHours(d,h){return new Date(d.getTime()+h*60*60*1000);}function formatDate(d){return Utilities.formatDate(d,GOVOPS.TZ,'yyyy-MM-dd HH:mm:ss');}function addDays(d,n){const x=new Date(d);x.setDate(x.getDate()+n);return Utilities.formatDate(x,GOVOPS.TZ,'yyyy-MM-dd');}function jsonOut(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
